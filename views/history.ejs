<!DOCTYPE html>
<html>
<head>
    <title>Snapshot History - Conda Environment Snapshot Manager</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Conda Environment Snapshot Manager</h1>
            <div class="user-info">
                <span>Current User: <%= user.username %></span>
                <a href="/logout" class="logout">Logout</a>
            </div>
        </header>
        
        <nav>
            <ul>
                <li><a href="/view">Query Snapshots</a></li>
                <li><a href="/report">Create Snapshot</a></li>
                <li><a href="/history" class="active">Snapshot History</a></li>
            </ul>
        </nav>
        
        <main>
            <h2>Environment Snapshot History</h2>
            <p>Total <%= nSnapshots %> snapshots</p>
            
            <% if (nSnapshots === 0) { %>
                <div class="message info">No snapshot data available. Please create a new environment snapshot.</div>
            <% } else { %>
                <table class="snapshot-table">
                    <thead>
                        <tr>
                            <th>Environment Name</th>
                            <th>Type</th>
                            <th>Creation Time</th>
                            <th>Number of Packages</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% snapshots.forEach(snapshot => { %>
                            <tr>
                                <td><%= snapshot.environmentName %></td>
                                <td><%= snapshot.environmentType === '正式环境' ? 'Production Environment' : 'Preview Environment' %></td>
                                <td><%= new Date(snapshot.createdAt).toLocaleString() %></td>
                                <td><%= snapshot.packages.length %></td>
                                <td class="actions">
                                    <a href="/update/<%= snapshot._id %>" class="btn edit">Edit</a>
                                    <form action="/delete" method="post" class="delete-form">
                                        <input type="hidden" name="_id" value="<%= snapshot._id %>">
                                        <button type="submit" class="btn delete" onclick="return confirm('Are you sure you want to delete this snapshot?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </main>
    </div>
</body>
</html>
