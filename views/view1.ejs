<!DOCTYPE html>
<html>
<head>
    <title>Query Results - Conda Environment Snapshot Manager</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Conda Environment Snapshot Manager</h1>
            <div class="user-info">
                <span>Current User: <%= user.username %></span>
                <a href="/logout" class="logout">Logout</a>
            </div>
        </header>
        
        <nav>
            <ul>
                <li><a href="/view" class="active">Query Snapshots</a></li>
                <li><a href="/report">Create Snapshot</a></li>
                <li><a href="/history">Snapshot History</a></li>
            </ul>
        </nav>
        
        <main>
            <h2>Snapshot Query Results</h2>
            
            <% if (message) { %>
                <div class="message info"><%= message %></div>
            <% } else { %>
                <p>Found <%= snapshots.length %> matching snapshots</p>
            <% } %>
            
            <% if (snapshots.length > 0) { %>
                <table class="snapshot-table">
                    <thead>
                        <tr>
                            <th>Environment Name</th>
                            <th>Environment Type</th>
                            <th>Creation Time</th>
                            <th>Number of Packages</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% snapshots.forEach(snapshot => { %>
                            <tr>
                                <td><%= snapshot.environmentName %></td>
                                <td><%= snapshot.environmentType === '正式环境' ? 'Production Environment' : 'Preview Environment' %></td>
                                <td><%= new Date(snapshot.createdAt).toLocaleString() %></td>
                                <td><%= snapshot.packages.length %></td>
                                <td><%= snapshot.description || 'None' %></td>
                                <td class="actions">
                                    <a href="/update/<%= snapshot._id %>" class="btn edit">Edit</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>

                <!-- Package list preview popup (optional, click row to view) -->
                <script>
                    // Optional: Click row to show package list details
                    document.querySelectorAll('.snapshot-table tr').forEach(row => {
                        row.addEventListener('click', function() {
                            const pkgCount = this.cells[3].textContent;
                            const envName = this.cells[0].textContent;
                            alert(`Environment ${envName} contains ${pkgCount} packages. Click "Edit" to view the detailed package list`);
                        });
                    });
                </script>
            <% } %>
            
            <div class="form-group" style="margin-top: 30px;">
                <a href="/view" class="btn" style="text-decoration: none; padding: 12px 20px; background-color: #3498db; color: white; border-radius: 4px;">Query Again</a>
            </div>
        </main>
    </div>
</body>
</html>
