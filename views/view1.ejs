<!DOCTYPE html>
<html>
<head>
    <title>查询结果 - Conda环境快照管理系统</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Conda环境快照管理系统</h1>
            <div class="user-info">
                <span>当前用户: <%= user.username %></span>
                <a href="/logout" class="logout">退出登录</a>
            </div>
        </header>
        
        <nav>
            <ul>
                <li><a href="/view" class="active">查询快照</a></li>
                <li><a href="/report">创建快照</a></li>
                <li><a href="/history">快照历史</a></li>
            </ul>
        </nav>
        
        <main>
            <h2>快照查询结果</h2>
            
            <% if (message) { %>
                <div class="message info"><%= message %></div>
            <% } else { %>
                <p>共找到 <%= snapshots.length %> 个符合条件的快照</p>
            <% } %>
            
            <% if (snapshots.length > 0) { %>
                <table class="snapshot-table">
                    <thead>
                        <tr>
                            <th>环境名称</th>
                            <th>环境类型</th>
                            <th>创建时间</th>
                            <th>包数量</th>
                            <th>描述</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% snapshots.forEach(snapshot => { %>
                            <tr>
                                <td><%= snapshot.environmentName %></td>
                                <td><%= snapshot.environmentType %></td>
                                <td><%= new Date(snapshot.createdAt).toLocaleString() %></td>
                                <td><%= snapshot.packages.length %></td>
                                <td><%= snapshot.description || '无' %></td>
                                <td class="actions">
                                    <a href="/update/<%= snapshot._id %>" class="btn edit">编辑</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>

                <!-- 包列表预览弹窗（可选，点击行查看） -->
                <script>
                    // 可选：点击行展示包列表详情
                    document.querySelectorAll('.snapshot-table tr').forEach(row => {
                        row.addEventListener('click', function() {
                            const pkgCount = this.cells[3].textContent;
                            const envName = this.cells[0].textContent;
                            alert(`环境 ${envName} 包含 ${pkgCount} 个包，可点击「编辑」查看详细包列表`);
                        });
                    });
                </script>
            <% } %>
            
            <div class="form-group" style="margin-top: 30px;">
                <a href="/view" class="btn" style="text-decoration: none; padding: 12px 20px; background-color: #3498db; color: white; border-radius: 4px;">重新查询</a>
            </div>
        </main>
    </div>
</body>
</html>