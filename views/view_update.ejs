<!DOCTYPE html>
<html>
<head>
    <title>Update Snapshot - Conda Environment Snapshot Manager</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Conda Environment Snapshot Manager</h1>
            <div class="user-info">
                <span>Current User: <%= user.username %></span>
                <a href="/logout" class="logout">Logout</a>
            </div>
        </header>
        
        <nav>
            <ul>
                <li><a href="/view">Query Snapshots</a></li>
                <li><a href="/report">Create Snapshot</a></li>
                <li><a href="/history">Snapshot History</a></li>
            </ul>
        </nav>
        
        <main>
            <h2>Update Environment Snapshot</h2>
            <p>Modify the following information and submit to update the snapshot content (the <code>conda list</code> text will be re-parsed for package information after modification).</p>
            
            <form action="/update/<%= snapshot._id %>" method="post">
                <div class="form-group">
                    <label for="environmentName">Environment Name <span class="required">*</span>:</label>
                    <input type="text" id="environmentName" name="environmentName" required 
                           value="<%= snapshot.environmentName %>" placeholder="e.g.: base, py38">
                </div>
                
                <div class="form-group">
                    <label for="environmentType">Environment Type <span class="required">*</span>:</label>
                    <select id="environmentType" name="environmentType" required>
                        <option value="Production" <%= snapshot.environmentType === 'Production' ? 'selected' : '' %>>Production Environment</option>
                        <option value="Preview" <%= snapshot.environmentType === 'Preview' ? 'selected' : '' %>>Preview Environment</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="description">Description:</label>
                    <textarea id="description" name="description" rows="3" placeholder="Optional: Describe the purpose, characteristics, etc. of this environment"><%= snapshot.description || '' %></textarea>
                </div>
                
                <div class="form-group">
                    <label for="rawText">Conda Environment List <span class="required">*</span>:</label>
                    <textarea id="rawText" name="rawText" rows="15" required placeholder="Paste the output of the conda list command (starting from the package list, excluding comment lines)"><%= snapshot.rawText %></textarea>
                    <p class="hint">Currently parsed <%= snapshot.packages.length %> packages. The text will be re-parsed after modification.</p>
                </div>
                
                <div class="form-group">
                    <button type="submit">Save Updates</button>
                    <a href="/history" style="margin-left: 10px; padding: 12px 20px; background-color: #6c757d; color: white; border-radius: 4px; text-decoration: none;">Cancel</a>
                </div>
            </form>

            <!-- Display current parsed package list preview -->
            <div class="form-group" style="margin-top: 30px;">
                <h3>Current Package List Preview (<%= snapshot.packages.length %> items)</h3>
                <div class="package-list">
                    <% snapshot.packages.forEach(pkg => { %>
                        <div class="package-item">
                            <strong><%= pkg.name %></strong> - Version: <%= pkg.version %> | Build: <%= pkg.build || 'None' %> | Channel: <%= pkg.channel || 'None' %>
                        </div>
                    <% }) %>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
