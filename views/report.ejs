<!DOCTYPE html>
<html>
<head>
    <title>Create Snapshot - Conda Environment Snapshot Manager</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Conda Environment Snapshot Manager</h1>
            <div class="user-info">
                <span>Current User: <%= user.username %></span>
                <a href="/logout" class="logout">Logout</a>
            </div>
        </header>
        
        <nav>
            <ul>
                <li><a href="/view">Query Snapshots</a></li>
                <li><a href="/report" class="active">Create Snapshot</a></li>
                <li><a href="/history">Snapshot History</a></li>
            </ul>
        </nav>
        
        <main>
            <h2>Create Environment Snapshot</h2>
            <p>Run <code>conda list</code> in your Conda environment on Linux terminal, copy the environment list (starting from the package list, excluding comment lines) into the text box below.</p>
            
            <form action="/report" method="post">
                <div class="form-group">
                    <label for="environmentName">Environment Name <span class="required">*</span>:</label>
                    <input type="text" id="environmentName" name="environmentName" required placeholder="e.g.: base, py38">
                </div>
                
                <div class="form-group">
                    <label for="environmentType">Environment Type <span class="required">*</span>:</label>
                    <select id="environmentType" name="environmentType" required>
                        <option value="">Please select type</option>
                        <option value="正式环境">Production Environment</option>
                        <option value="预览环境">Preview Environment</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="description">Description:</label>
                    <textarea id="description" name="description" rows="3" placeholder="Optional: Describe the purpose, features, etc. of this environment"></textarea>
                </div>
                
                <div class="form-group">
                    <label for="rawText">Conda Environment List <span class="required">*</span>:</label>
                    <textarea id="rawText" name="rawText" rows="15" required placeholder="Paste the output of the conda list command (starting from the package list, excluding comment lines)"></textarea>
                    <p class="hint">Example:
                        <pre>_libgcc_mutex 0.1 main
_openmp_mutex 5.1 1_gnu
anaconda-anon-usage 0.7.1 py313hfc0e8ea_100
annotated-types 0.6.0 py313h06a4308_0</pre>
                    </p>
                </div>
                
                <div class="form-group">
                    <button type="submit">Create Snapshot</button>
                </div>
            </form>
        </main>
    </div>
</body>
</html>
