<!DOCTYPE html>
<html>
<head>
    <title>Query Snapshots - Conda Environment Snapshot Manager</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Conda Environment Snapshot Manager</h1>
            <div class="user-info">
                <span>Current User: <%= user.username %></span>
                <a href="/logout" class="logout">Logout</a>
            </div>
        </header>
        
        <nav>
            <ul>
                <li><a href="/view" class="active">Query Snapshots</a></li>
                <li><a href="/report">Create Snapshot</a></li>
                <li><a href="/history">Snapshot History</a></li>
            </ul>
        </nav>
        
        <main>
            <h2>Query Environment Snapshots</h2>
            <form action="/view" method="post">
                <div class="form-group">
                    <label for="environmentName">Environment Name:</label>
                    <input type="text" id="environmentName" name="environmentName" placeholder="e.g.: base, py38">
                </div>
                
                <div class="form-group">
                    <label for="environmentType">Environment Type:</label>
                    <select id="environmentType" name="environmentType">
                        <option value="all">All Types</option>
                        <option value="正式环境">Production Environment</option>
                        <option value="预览环境">Preview Environment</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="packageName">Included Package Name:</label>
                    <input type="text" id="packageName" name="packageName" placeholder="e.g.: numpy, pandas">
                </div>
                
                <div class="form-group">
                    <button type="submit">Query</button>
                </div>
            </form>
        </main>
    </div>
</body>
</html>
