<!DOCTYPE html>
<html>
<head>
    <title>Operation Result - Conda Environment Snapshot Manager</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Conda Environment Snapshot Manager</h1>
            <div class="user-info">
                <% if (user) { %>
                    <span>Current User: <%= user.username %></span>
                    <a href="/logout" class="logout">Logout</a>
                <% } %>
            </div>
        </header>
        
        <nav>
            <ul>
                <li><a href="/view">Query Snapshots</a></li>
                <li><a href="/report">Create Snapshot</a></li>
                <li><a href="/history">Snapshot History</a></li>
            </ul>
        </nav>
        
        <main>
            <div class="message info">
                <h2><%= message %></h2>
            </div>
            <div class="form-group" style="margin-top: 30px;">
                <a href="/view" class="btn" style="text-decoration: none; padding: 12px 20px; background-color: #3498db; color: white; border-radius: 4px;">Return to Query Page</a>
                <a href="/report" class="btn" style="text-decoration: none; padding: 12px 20px; background-color: #28a745; color: white; border-radius: 4px; margin-left: 10px;">Create New Snapshot</a>
                <a href="/history" class="btn" style="text-decoration: none; padding: 12px 20px; background-color: #17a2b8; color: white; border-radius: 4px; margin-left: 10px;">View Snapshot History</a>
            </div>
        </main>
    </div>
</body>
</html>
